      "parameters": {
        "jsCode": "const x=$json;\nconst clamp=v=>Math.max(0,Math.min(10,Number(v||0)));\nconst score =\n clamp(x.calendarCompatibility)*1.5 +\n clamp(x.travelConvenience)*1.0 +\n clamp(x.socialQuality)*1.5 +\n clamp(x.audienceFit)*1.0 +\n clamp(x.fitnessValue)*0.8 +\n clamp(x.growthValue)*0.8 +\n clamp(x.networkingValue)*0.8 +\n clamp(x.organicConnectionPotential)*0.8 +\n clamp(x.funNovelty)*0.7 +\n clamp(x.valueForMoney)*0.6 +\n clamp(x.soloFriendly)*0.5 -\n Math.max(0,Number(x.penalty||0));\nconst finalScore=Math.max(0,Math.min(100,Math.round(score)));\nconst classification=finalScore>=85?'Must Go':finalScore>=70?'Strong Match':finalScore>=55?'Good Alternative':'Do Not Recommend';\nreturn [{json:{...x,score:finalScore,classification}}];"
      },
